@@append u1-l4
    <h4>تمرين سريع</h4>
    <div class="ex">
      <div class="bt"><span class="lvl">⭐</span>تتبّع المتغيّرات</div>
      <p>توقّع الناتج: متغيّر مدينة اتغيّر، وعدّاد زيارات زاد مرّتين.</p>
      <details class="sol"><summary>شوف الحل</summary>
      @code run
city = "طنطا" ¦¦ القيمة الأولى.
city = "القاهرة" ¦¦ إعادة إسناد — القيمة القديمة راحت.
visits = 3 ¦¦ رقم.
visits += 2 ¦¦ اختصار `visits = visits + 2`.
total_price = visits * 50 ¦¦ متغيّر من عملية على متغيّر تاني. الاسم snake_case.
print(city, visits, total_price) ¦¦ آخر قيمة لكل متغيّر.
      @end
      @out rtl
القاهرة 5 250
      @end
      </details>
    </div>

    <h4>اختبار سريع</h4>
    <div class="quiz">
      <div class="q" data-a="2">
        <p class="qt">1. أنهي اسم متغيّر صحيح؟</p>
        <label><input type="radio"> 2name</label>
        <label><input type="radio"> my-name</label>
        <label><input type="radio"> my_name</label>
        <label><input type="radio"> my name</label>
      </div>
      <div class="q" data-a="1">
        <p class="qt">2. <code class="inl">x = 5</code> ثم <code class="inl">x += 3</code> — قيمة x؟</p>
        <label><input type="radio"> 5</label>
        <label><input type="radio"> 8</label>
        <label><input type="radio"> 53</label>
        <label><input type="radio"> خطأ</label>
      </div>
      <div class="q" data-a="0">
