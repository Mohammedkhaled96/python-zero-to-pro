@@append u17-l3
    <h4>تمرين سريع</h4>
    <div class="ex">
      <div class="bt"><span class="lvl">⭐⭐</span>أول ظهور</div>
      <p>عدّل البحث الثنائي بحيث يرجّع مكان <strong>أول</strong> ظهور لرقم متكرّر، وقارن بـ <code class="inl">bisect</code> المدمجة.</p>
      <details class="sol"><summary>شوف الحل</summary>
      @code run
import bisect ¦¦ البحث الثنائي الجاهز.
 ¦¦
def first_index(items, target): ¦¦ القائمة لازم تكون مرتّبة.
    low, high = 0, len(items) - 1 ¦¦ الحدود.
    answer = -1 ¦¦ لو ما لقيناش.
    while low <= high: ¦¦ طول ما فيه مدى.
        mid = (low + high) // 2 ¦¦ النص.
        if items[mid] == target: ¦¦ لقيناه…
            answer = mid ¦¦ …نسجّله…
            high = mid - 1 ¦¦ …ونكمّل يمين-شمال عشان نلاقي ظهور أبكر.
        elif items[mid] < target: ¦¦ الهدف أكبر.
            low = mid + 1 ¦¦ النص اليمين.
        else: ¦¦ الهدف أصغر.
            high = mid - 1 ¦¦ النص الشمال.
    return answer ¦¦ النتيجة.
 ¦¦
data = [1, 3, 3, 3, 5, 8, 8, 9] ¦¦ مرتّبة وفيها تكرار.
print(first_index(data, 3), first_index(data, 8), first_index(data, 4)) ¦¦ أول 3، أول 8، مش موجود.
print(bisect.bisect_left(data, 3), bisect.bisect_left(data, 8)) ¦¦ `bisect_left` بترجّع نفس المكان.
      @end
      @out
1 5 -1
1 5
      @end
      </details>
    </div>

