      @code run
def cap(word): ¦¦ الدالة.
    return word[:1].upper() + word[1:] ¦¦ `[:1]` بدل `[0]` عشان النص الفاضي ما يرميش IndexError.
 ¦¦
assert cap("python") == "Python" ¦¦ بتعدّي بصمت.
assert cap("") == "" ¦¦ الحالة الحدّية.
try: ¦¦ نجرّب واحدة فاشلة عن قصد.
    assert cap("ali") == "ALI", f"متوقّع ALI لكن طلع {cap('ali')}" ¦¦ الرسالة بعد الفاصلة.
except AssertionError as e: ¦¦ نمسكها عشان نشوف الرسالة.
    print("فشل:", e) ¦¦ الرسالة.
print("خلصنا") ¦¦ النهاية.
      @end
      @out rtl
فشل: متوقّع ALI لكن طلع Ali
خلصنا
      @end
      </details>
