@@append u17-l2
    <h4>تمرين سريع</h4>
    <div class="ex">
      <div class="bt"><span class="lvl">⭐⭐</span>عدّ الخطوات</div>
      <p>اعدّ عدد عمليات المقارنة في حلقة واحدة وحلقتين متداخلتين لما n تتضاعف — وشوف O(n) و O(n²) بعينك.</p>
      <details class="sol"><summary>شوف الحل</summary>
      @code run
def linear_ops(n): ¦¦ حلقة واحدة.
    ops = 0 ¦¦ عدّاد.
    for i in range(n): ¦¦ n مرّة.
        ops += 1 ¦¦ عملية.
    return ops ¦¦ = n.
 ¦¦
def pairs_ops(n): ¦¦ حلقتين.
    ops = 0 ¦¦ عدّاد.
    for i in range(n): ¦¦ n مرّة…
        for j in range(n): ¦¦ …في n مرّة.
            ops += 1 ¦¦ عملية.
    return ops ¦¦ = n².
 ¦¦
for n in [10, 20, 40]: ¦¦ نضاعف الحجم.
    print(n, linear_ops(n), pairs_ops(n)) ¦¦ الخطّي بيتضاعف، والتربيعي بيتضرب في 4.
      @end
      @out
10 10 100
20 20 400
40 40 1600
      @end
      </details>
    </div>

