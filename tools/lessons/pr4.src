@@append u17-l5
    <h4>تمرين سريع</h4>
    <div class="ex">
      <div class="bt"><span class="lvl">⭐⭐⭐</span>الأقواس المتوازنة + طابور طباعة</div>
      <p>استخدم مكدّس عشان تتأكّد إن الأقواس متوازنة، وطابور <code class="inl">deque</code> لمحاكاة طابور طباعة.</p>
      <details class="sol"><summary>شوف الحل</summary>
      @code run
from collections import deque ¦¦ الطابور الكفء.
 ¦¦
def balanced(text): ¦¦ فحص الأقواس.
    pairs = {")": "(", "]": "[", "}": "{"} ¦¦ كل قوس قفل وقوس فتحه.
    stack = [] ¦¦ المكدّس (LIFO): قائمة عادية.
    for ch in text: ¦¦ حرف حرف.
        if ch in "([{": ¦¦ فتح؟
            stack.append(ch) ¦¦ push.
        elif ch in pairs: ¦¦ قفل؟
            if not stack or stack.pop() != pairs[ch]: ¦¦ مفيش فتح، أو آخر فتح مش من نوعه.
                return False ¦¦ مش متوازن.
    return not stack ¦¦ لازم المكدّس يفضى في الآخر.
 ¦¦
for t in ["(a[b]{c})", "(]", "((x)"]: ¦¦ حالات.
    print(t, balanced(t)) ¦¦ النتيجة.
 ¦¦
printer = deque(["تقرير", "فاتورة"]) ¦¦ الطابور (FIFO).
printer.append("صورة") ¦¦ يدخل من الآخر.
while printer: ¦¦ طول ما فيه شغل.
    print("طباعة:", printer.popleft()) ¦¦ يخرج من الأول — O(1).
      @end
      @out
(a[b]{c}) True
(] False
((x) False
طباعة: تقرير
طباعة: فاتورة
طباعة: صورة
      @end
      </details>
    </div>

