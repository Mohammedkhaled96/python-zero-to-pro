@@append u15-l5
    <h4>تمرين سريع</h4>
    <div class="ex">
      <div class="bt"><span class="lvl">⭐⭐</span>موظفين</div>
      <p>كلاس <code class="inl">Employee</code> بمرتّب، و <code class="inl">Manager</code> بيورث منه وبيضيف مكافأة باستخدام <code class="inl">super()</code>.</p>
      <details class="sol"><summary>شوف الحل</summary>
      @code run
class Employee: ¦¦ الأب.
    def __init__(self, name, salary): ¦¦ الإنشاء.
        self.name = name ¦¦ الاسم.
        self.salary = salary ¦¦ المرتّب.
 ¦¦
    def pay(self): ¦¦ الدفع.
        return self.salary ¦¦ المرتّب بس.
 ¦¦
class Manager(Employee): ¦¦ الابن بيورث كل حاجة.
    def __init__(self, name, salary, bonus): ¦¦ بيانات زيادة.
        super().__init__(name, salary) ¦¦ نسيب الأب يجهّز الجزء بتاعه.
        self.bonus = bonus ¦¦ الجزء الجديد.
 ¦¦
    def pay(self): ¦¦ إعادة تعريف (override).
        return super().pay() + self.bonus ¦¦ نبني على نسخة الأب بدل ما ننسخ الكود.
 ¦¦
staff = [Employee("علي", 8000), Manager("سارة", 12000, 3000)] ¦¦ قائمة مختلطة.
for person in staff: ¦¦ نفس الاستدعاء لكل واحد.
    print(person.name, person.pay()) ¦¦ كل كلاس بيرد بطريقته.
print(isinstance(staff[1], Employee)) ¦¦ المدير «موظف» برضه.
      @end
      @out
علي 8000
سارة 15000
True
      @end
      </details>
    </div>

    <h4>اختبار سريع</h4>
    <div class="quiz">
      <div class="q" data-a="2">
        <p class="qt">1. الابن عرّف <code class="inl">__init__</code> ونسي <code class="inl">super().__init__</code>…</p>
        <label><input type="radio"> بايثون بتناديها أوتوماتيك</label>
        <label><input type="radio"> SyntaxError</label>
        <label><input type="radio"> خصائص الأب ما اتعملتش — AttributeError بعدين</label>
        <label><input type="radio"> مفيش مشكلة</label>
      </div>
      <div class="q" data-a="1">
        <p class="qt">2. «يورث» مناسبة لما العلاقة…</p>
        <label><input type="radio"> «عنده» (has-a)</label>
        <label><input type="radio"> «هو نوع من» (is-a)</label>
        <label><input type="radio"> أي علاقة</label>
        <label><input type="radio"> مفيش علاقة</label>
      </div>
      <div class="q" data-a="0">
        <p class="qt">3. <code class="inl">issubclass(Manager, Employee)</code>؟</p>
        <label><input type="radio"> True</label>
        <label><input type="radio"> False</label>
        <label><input type="radio"> خطأ</label>
        <label><input type="radio"> None</label>
      </div>
    </div>

@@append u15-l6
    <h4>تمرين سريع</h4>
    <div class="ex">
      <div class="bt"><span class="lvl">⭐⭐</span>درجة حرارة بحماية</div>
      <p>كلاس بخاصية <code class="inl">celsius</code> محمية (مينفعش تقل عن -273.15)، وخاصية <code class="inl">fahrenheit</code> محسوبة للقراءة بس.</p>
      <details class="sol"><summary>شوف الحل</summary>
      @code run
class Temperature: ¦¦ الكلاس.
    def __init__(self, celsius): ¦¦ الإنشاء.
        self.celsius = celsius ¦¦ ده بيعدّي على الـ setter تحت — حتى الإنشاء محمي.
 ¦¦
    @property ¦¦ قراءة.
    def celsius(self): ¦¦ `t.celsius`.
        return self._celsius ¦¦ القيمة المخزّنة (الشرطة = «داخلي»).
 ¦¦
    @celsius.setter ¦¦ كتابة.
    def celsius(self, value): ¦¦ `t.celsius = x`.
        if value < -273.15: ¦¦ تحقّق.
            raise ValueError("أقل من الصفر المطلق") ¦¦ نرفض.
        self._celsius = value ¦¦ نحفظ.
 ¦¦
    @property ¦¦ خاصية محسوبة من غير setter.
    def fahrenheit(self): ¦¦ `t.fahrenheit`.
        return self._celsius * 9 / 5 + 32 ¦¦ التحويل.
 ¦¦
t = Temperature(25) ¦¦ كائن.
print(t.celsius, t.fahrenheit) ¦¦ من غير أقواس — شكلها خاصية.
try: ¦¦ قيمة مستحيلة.
    t.celsius = -300 ¦¦ الـ setter بيرفض.
except ValueError as e: ¦¦ نمسك.
    print("مرفوض:", e) ¦¦ الرسالة.
try: ¦¦ كتابة على خاصية للقراءة بس.
    t.fahrenheit = 100 ¦¦ مفيش setter.
except AttributeError: ¦¦ نمسك.
    print("fahrenheit للقراءة بس") ¦¦ الرسالة.
      @end
      @out rtl
25 77.0
مرفوض: أقل من الصفر المطلق
fahrenheit للقراءة بس
      @end
      </details>
    </div>

    <h4>اختبار سريع</h4>
    <div class="quiz">
      <div class="q" data-a="3">
        <p class="qt">1. <code class="inl">_balance</code> (شرطة واحدة) معناها…</p>
        <label><input type="radio"> ممنوع الوصول ليها نهائيًا</label>
        <label><input type="radio"> ثابت</label>
        <label><input type="radio"> خاصية كلاس</label>
        <label><input type="radio"> اتفاق: «داخلية، ما تلمسهاش من برّه»</label>
      </div>
      <div class="q" data-a="1">
        <p class="qt">2. property من غير setter وحاولت تكتب عليها…</p>
        <label><input type="radio"> بتتكتب عادي</label>
        <label><input type="radio"> AttributeError</label>
        <label><input type="radio"> ValueError</label>
        <label><input type="radio"> بتتجاهل بصمت</label>
      </div>
      <div class="q" data-a="2">
        <p class="qt">3. بتقرا property إزاي؟</p>
        <label><input type="radio"> t.celsius()</label>
        <label><input type="radio"> t.get_celsius()</label>
        <label><input type="radio"> t.celsius</label>
        <label><input type="radio"> Temperature.celsius(t)()</label>
      </div>
    </div>

@@append u15-l7
    <h4>تمرين سريع</h4>
    <div class="ex">
      <div class="bt"><span class="lvl">⭐⭐</span>طرق دفع</div>
      <p>تلات كلاسات مالهمش أب مشترك، بس كلهم فيهم <code class="inl">pay(amount)</code> — دالة واحدة تتعامل معاهم كلهم (Duck Typing).</p>
      <details class="sol"><summary>شوف الحل</summary>
      @code run
class Cash: ¦¦ طريقة أولى.
    def pay(self, amount): ¦¦ نفس الاسم.
        return f"كاش: {amount}" ¦¦ سلوكها.
 ¦¦
class Card: ¦¦ طريقة تانية.
    def pay(self, amount): ¦¦ نفس الاسم.
        return f"فيزا: {amount} + رسوم {amount * 0.02}" ¦¦ سلوك مختلف.
 ¦¦
class Wallet: ¦¦ طريقة تالتة.
    def pay(self, amount): ¦¦ نفس الاسم.
        return f"محفظة: {amount}" ¦¦ سلوكها.
 ¦¦
def checkout(method, amount): ¦¦ مش مهم النوع — المهم «بيعرف يدفع».
    print(method.pay(amount)) ¦¦ تعدّد الأشكال.
 ¦¦
for m in [Cash(), Card(), Wallet()]: ¦¦ كائنات مختلفة.
    checkout(m, 500) ¦¦ نفس الاستدعاء.
      @end
      @out rtl
كاش: 500
فيزا: 500 + رسوم 10.0
محفظة: 500
      @end
      </details>
    </div>

    <h4>اختبار سريع</h4>
    <div class="quiz">
      <div class="q" data-a="0">
        <p class="qt">1. Duck Typing معناه…</p>
        <label><input type="radio"> المهم الكائن يعرف يعمل المطلوب، مش نوعه</label>
        <label><input type="radio"> لازم كل الكلاسات تورث من أب واحد</label>
        <label><input type="radio"> لازم تفحص النوع بـ type</label>
        <label><input type="radio"> نوع بيانات جديد</label>
      </div>
      <div class="q" data-a="2">
        <p class="qt">2. <code class="inl">len("abc")</code> و <code class="inl">len([1, 2])</code> مثال على…</p>
        <label><input type="radio"> الوراثة</label>
        <label><input type="radio"> التغليف</label>
        <label><input type="radio"> تعدّد الأشكال</label>
        <label><input type="radio"> الاسترجاع</label>
      </div>
      <div class="q" data-a="3">
        <p class="qt">3. كلاس بيورث من ABC ومش معرّف الدالة المجرّدة، وحاولت تعمل منه كائن…</p>
        <label><input type="radio"> بيشتغل عادي</label>
        <label><input type="radio"> الدالة بترجّع None</label>
        <label><input type="radio"> تحذير</label>
        <label><input type="radio"> TypeError</label>
      </div>
    </div>

@@append u16-l1
    <h4>تمرين سريع</h4>
    <div class="ex">
      <div class="bt"><span class="lvl">⭐</span>اختبر قبل ما تثق</div>
      <p>الدالة دي «شكلها صح». اكتب 3 فحوصات بسيطة تكشف مشكلتها.</p>
      <details class="sol"><summary>شوف الحل</summary>
      @code run
