@@append u15-l2
    <h4>تمرين سريع</h4>
    <div class="ex">
      <div class="bt"><span class="lvl">⭐⭐</span>عدّاد خطوات</div>
      <p>كلاس <code class="inl">StepCounter</code> فيه هدف يومي، ودالة بتزوّد خطوات، ودالة بترجّع النسبة المئوية.</p>
      <details class="sol"><summary>شوف الحل</summary>
      @code run
class StepCounter: ¦¦ الكلاس.
    def __init__(self, goal=8000): ¦¦ هدف افتراضي.
        self.goal = goal ¦¦ خاصية الهدف.
        self.steps = 0 ¦¦ خاصية بتبدأ بصفر — مش جاية من برّه.
 ¦¦
    def walk(self, n): ¦¦ دالة بتعدّل حالة الكائن.
        self.steps += n ¦¦ `self` = الكائن اللي نادى.
 ¦¦
    def progress(self): ¦¦ دالة بترجّع قيمة.
        return round(self.steps / self.goal * 100) ¦¦ النسبة.
 ¦¦
me = StepCounter() ¦¦ كائن بالهدف الافتراضي.
friend = StepCounter(4000) ¦¦ كائن تاني بهدف مختلف.
me.walk(2000) ¦¦ بايثون بتحوّلها لـ `StepCounter.walk(me, 2000)`.
me.walk(1000) ¦¦ تراكم.
friend.walk(3000) ¦¦ حالة مستقلّة.
print(me.steps, me.progress()) ¦¦ 3000 من 8000.
print(friend.steps, friend.progress()) ¦¦ 3000 من 4000.
      @end
      @out
3000 38
3000 75
      @end
      </details>
    </div>

    <h4>اختبار سريع</h4>
    <div class="quiz">
      <div class="q" data-a="2">
        <p class="qt">1. <code class="inl">__init__</code> بتتنادى إمتى؟</p>
        <label><input type="radio"> لازم تناديها بنفسك</label>
        <label><input type="radio"> لما البرنامج يخلص</label>
        <label><input type="radio"> أوتوماتيك لما تعمل كائن جديد</label>
        <label><input type="radio"> مرّة واحدة للكلاس كله</label>
      </div>
      <div class="q" data-a="0">
        <p class="qt">2. نسيت <code class="inl">self</code> في <code class="inl">def walk(n):</code> ثم <code class="inl">me.walk(5)</code>…</p>
        <label><input type="radio"> TypeError: takes 1 positional argument but 2 were given</label>
        <label><input type="radio"> بتشتغل عادي</label>
        <label><input type="radio"> n = self</label>
        <label><input type="radio"> SyntaxError</label>
      </div>
      <div class="q" data-a="1">
        <p class="qt">3. <code class="inl">steps = 0</code> من غير <code class="inl">self.</code> جوّه __init__…</p>
        <label><input type="radio"> خاصية عادية</label>
        <label><input type="radio"> متغيّر محلّي بيختفي بعد __init__</label>
        <label><input type="radio"> خطأ</label>
        <label><input type="radio"> خاصية كلاس</label>
      </div>
    </div>

@@append u15-l3
    <h4>تمرين سريع</h4>
    <div class="ex">
      <div class="bt"><span class="lvl">⭐⭐</span>سلة مشتريات بتتصرّف زي القائمة</div>
      <p>اعمل كلاس <code class="inl">Cart</code> يدعم <code class="inl">len</code> و <code class="inl">in</code> و <code class="inl">print</code> و <code class="inl">+</code>.</p>
      <details class="sol"><summary>شوف الحل</summary>
      @code run
class Cart: ¦¦ الكلاس.
    def __init__(self, items=None): ¦¦ `None` بدل `[]` كافتراضي (القائمة الافتراضية بتتشارك بين الكائنات).
        self.items = list(items or []) ¦¦ نسخة جديدة دايمًا.
 ¦¦
    def __len__(self): ¦¦ `len(cart)`.
        return len(self.items) ¦¦ عدد العناصر.
 ¦¦
    def __contains__(self, item): ¦¦ `x in cart`.
        return item in self.items ¦¦ نحوّل السؤال للقائمة.
 ¦¦
    def __add__(self, other): ¦¦ `cart1 + cart2`.
        return Cart(self.items + other.items) ¦¦ كائن **جديد** — الأصلين ما اتغيّروش.
 ¦¦
    def __str__(self): ¦¦ `print(cart)`.
        return "سلة: " + "، ".join(self.items) ¦¦ نص مقروء.
 ¦¦
a = Cart(["عيش", "لبن"]) ¦¦ سلة.
b = Cart(["شاي"]) ¦¦ سلة تانية.
both = a + b ¦¦ `__add__`.
print(both) ¦¦ `__str__`.
print(len(both), "شاي" in both, "بن" in both) ¦¦ `__len__` و `__contains__`.
      @end
      @out rtl
سلة: عيش، لبن، شاي
3 True False
      @end
      </details>
    </div>

    <h4>اختبار سريع</h4>
    <div class="quiz">
      <div class="q" data-a="3">
        <p class="qt">1. <code class="inl">a == b</code> بتنادي…</p>
        <label><input type="radio"> __cmp__</label>
        <label><input type="radio"> __is__</label>
        <label><input type="radio"> __equal__</label>
        <label><input type="radio"> __eq__</label>
      </div>
      <div class="q" data-a="0">
        <p class="qt">2. الفرق بين <code class="inl">__str__</code> و <code class="inl">__repr__</code>؟</p>
        <label><input type="radio"> str للمستخدم، repr للمبرمج (ويظهر جوّه القوائم)</label>
        <label><input type="radio"> مفيش فرق</label>
        <label><input type="radio"> repr أسرع</label>
        <label><input type="radio"> str للأرقام بس</label>
      </div>
      <div class="q" data-a="2">
        <p class="qt">3. لو الكلاس مفيهوش <code class="inl">__len__</code> و ناديت <code class="inl">len(obj)</code>…</p>
        <label><input type="radio"> 0</label>
        <label><input type="radio"> None</label>
        <label><input type="radio"> TypeError</label>
        <label><input type="radio"> 1</label>
      </div>
    </div>

