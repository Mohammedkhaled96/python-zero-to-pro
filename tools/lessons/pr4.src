      @code run
class Player: ¦¦ الكلاس.
    count = 0 ¦¦ خاصية **كلاس**: نسخة واحدة مشتركة.
 ¦¦
    def __init__(self, name): ¦¦ الإنشاء.
        self.name = name ¦¦ خاصية **كائن**.
        Player.count += 1 ¦¦ نعدّل عن طريق اسم الكلاس — مش `self.count`.
 ¦¦
p1 = Player("علي") ¦¦ الأول.
p2 = Player("منى") ¦¦ التاني.
print(Player.count, p1.count) ¦¦ القراءة من الكائن بتوصل لخاصية الكلاس.
p1.count = 100 ¦¦ ⚠️ ده بيعمل خاصية **جديدة** على p1 بس — بتغطّي على خاصية الكلاس.
print(Player.count, p1.count, p2.count) ¦¦ الكلاس و p2 ما اتأثّروش.
      @end
      @out
2 2
2 100 2
      @end
      </details>
    </div>

