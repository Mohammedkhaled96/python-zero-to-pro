      @code run
book_dict = {"title": "بايثون", "pages": 300} ¦¦ القاموس: مفيش شكل مضمون.
print(book_dict.get("titel")) ¦¦ غلطة إملائية ← None بهدوء (خطأ مستخبّي).
 ¦¦
class Book: ¦¦ الكلاس = قالب بشكل ثابت.
    def __init__(self, title, pages): ¦¦ كل كتاب لازم يتعمل بالبيانات دي.
        self.title = title ¦¦ خاصية.
        self.pages = pages ¦¦ خاصية.
 ¦¦
b = Book("بايثون", 300) ¦¦ كائن.
print(b.title, b.pages) ¦¦ الوصول بالنقطة.
try: ¦¦ نفس الغلطة الإملائية.
    print(b.titel) ¦¦ خاصية مش موجودة.
except AttributeError: ¦¦ خطأ واضح فورًا.
    print("الكلاس كشف الغلطة") ¦¦ أحسن من None الصامتة.
      @end
      @out rtl
None
بايثون 300
الكلاس كشف الغلطة
      @end
      </details>
    </div>

