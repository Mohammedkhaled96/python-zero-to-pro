def average(nums): ¦¦ الدالة.
    total = 0 ¦¦ التجميع.
    for i in range(1, len(nums)): ¦¦ ⚠️ البداية من 1 — بتتخطّى أول عنصر.
        breakpoint() ¦¦ البرنامج بيقف هنا ويفتح pdb.
        total += nums[i] ¦¦ الجمع.
    return total / len(nums) ¦¦ القسمة.
 ¦¦
print(average([10, 20, 30])) ¦¦ المتوقّع 20.0 … الفعلي 16.666…
      @end
