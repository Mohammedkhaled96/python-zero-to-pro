@@append u10-l2
    <h4>تمرين سريع</h4>
    <div class="ex">
      <div class="bt"><span class="lvl">⭐⭐</span>أكتر كلمات تكرارًا</div>
      <p>اعدّ الكلمات في جملة بقاموس، واطبع أكتر كلمتين تكرارًا، وبعدين اطبع كل الكلمات اللي ظهرت مرّة واحدة.</p>
      <details class="sol"><summary>شوف الحل</summary>
      @code run
text = "بايثون سهلة و بايثون قوية و بايثون ممتعة" ¦¦ جملة.
counts = {} ¦¦ قاموس العدّ.
for word in text.split(): ¦¦ كلمة كلمة.
    counts[word] = counts.get(word, 0) + 1 ¦¦ `get` بقيمة افتراضية 0 — من غير if.
top = sorted(counts.items(), key=lambda pair: pair[1], reverse=True) ¦¦ ترتيب الأزواج بالقيمة تنازليًا.
for word, n in top[:2]: ¦¦ أول اتنين.
    print(word, n) ¦¦ الكلمة وعددها.
once = [w for w, n in counts.items() if n == 1] ¦¦ فلترة بالقيمة.
print(once) ¦¦ بترتيب أول ظهور (القاموس بيحافظ على الترتيب).
      @end
      @out
بايثون 3
و 2
['سهلة', 'قوية', 'ممتعة']
      @end
      </details>
    </div>

    <h4>اختبار سريع</h4>
    <div class="quiz">
      <div class="q" data-a="2">
        <p class="qt">1. <code class="inl">for k in d:</code> بتلف على…</p>
        <label><input type="radio"> القيم</label>
        <label><input type="radio"> الأزواج</label>
        <label><input type="radio"> المفاتيح</label>
        <label><input type="radio"> خطأ</label>
      </div>
      <div class="q" data-a="0">
        <p class="qt">2. <code class="inl">d.get("x", 0)</code> والمفتاح مش موجود…</p>
        <label><input type="radio"> 0 — والقاموس ما بيتغيّرش</label>
        <label><input type="radio"> KeyError</label>
        <label><input type="radio"> None</label>
        <label><input type="radio"> بيضيف x بقيمة 0</label>
      </div>
      <div class="q" data-a="3">
        <p class="qt">3. <code class="inl">{"a": 1, "b": 2}.pop("a")</code> بترجّع…</p>
        <label><input type="radio"> "a"</label>
        <label><input type="radio"> ("a", 1)</label>
        <label><input type="radio"> None</label>
        <label><input type="radio"> 1</label>
      </div>
    </div>

@@append u10-l4
    <h4>تمرين سريع</h4>
    <div class="ex">
      <div class="bt"><span class="lvl">⭐⭐</span>أصحاب مشتركين</div>
      <p>بمجموعات: لاقي الأصحاب المشتركين، اللي عند علي بس، وكل الأصحاب. وبعدين استخدم tuple كمفتاح قاموس لإحداثيات.</p>
      <details class="sol"><summary>شوف الحل</summary>
      @code run
ali = {"منى", "سارة", "كريم", "يوسف"} ¦¦ أصحاب علي.
mona = {"سارة", "يوسف", "هند"} ¦¦ أصحاب منى.
print(sorted(ali & mona)) ¦¦ التقاطع: المشتركين (`sorted` لأن ترتيب المجموعة مش ثابت).
print(sorted(ali - mona)) ¦¦ الفرق: عند علي بس.
print(len(ali | mona)) ¦¦ الاتحاد من غير تكرار.
cities = {(30.04, 31.24): "القاهرة", (31.20, 29.92): "الإسكندرية"} ¦¦ tuple ينفع مفتاح لأنه ثابت (قائمة ما تنفعش).
lat, lon = 30.04, 31.24 ¦¦ إحداثيات.
print(cities[(lat, lon)]) ¦¦ البحث بالـ tuple.
      @end
      @out
['سارة', 'يوسف']
['كريم', 'منى']
5
القاهرة
      @end
      </details>
    </div>

