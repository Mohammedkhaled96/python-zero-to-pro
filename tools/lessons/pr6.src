      </div>
    </div>

@@append u16-l5
    <h4>تمرين سريع</h4>
    <div class="ex">
      <div class="bt"><span class="lvl">⭐⭐</span>TestCase كامل</div>
      <p>اكتب كلاس اختبار لكلاس <code class="inl">Wallet</code> فيه <code class="inl">setUp</code> وتلات اختبارات، وشغّله برمجيًا واطبع ملخّص النتيجة.</p>
      <details class="sol"><summary>شوف الحل</summary>
      @code run
import io ¦¦ عشان نوجّه تقرير unittest لمكان مؤقّت.
import unittest ¦¦ المكتبة المدمجة.
 ¦¦
class Wallet: ¦¦ الكود المختبَر.
    def __init__(self): ¦¦ الإنشاء.
        self.balance = 0 ¦¦ رصيد.
    def deposit(self, amount): ¦¦ إيداع.
        if amount <= 0: ¦¦ تحقّق.
            raise ValueError("المبلغ لازم يكون موجب") ¦¦ خطأ.
        self.balance += amount ¦¦ إضافة.
 ¦¦
class TestWallet(unittest.TestCase): ¦¦ كلاس الاختبارات.
    def setUp(self): ¦¦ بيتنادى قبل **كل** اختبار ← محفظة جديدة.
        self.w = Wallet() ¦¦ التجهيز.
    def test_starts_empty(self): ¦¦ اختبار 1.
        self.assertEqual(self.w.balance, 0) ¦¦ مساواة.
    def test_deposit(self): ¦¦ اختبار 2.
        self.w.deposit(50) ¦¦ فعل.
        self.assertEqual(self.w.balance, 50) ¦¦ تأكيد.
    def test_negative(self): ¦¦ اختبار 3.
        with self.assertRaises(ValueError): ¦¦ لازم يرمي الخطأ.
            self.w.deposit(-5) ¦¦ مبلغ غلط.
 ¦¦
suite = unittest.TestLoader().loadTestsFromTestCase(TestWallet) ¦¦ تجميع الاختبارات.
result = unittest.TextTestRunner(stream=io.StringIO()).run(suite) ¦¦ تشغيل (التقرير النصّي في StringIO عشان فيه وقت بيتغيّر).
print(result.testsRun, len(result.failures), len(result.errors)) ¦¦ عدد اللي اشتغل، والفاشل، والأخطاء.
print(result.wasSuccessful()) ¦¦ الكل نجح؟
      @end
      @out
3 0 0
True
      @end
      <p>في مشروع حقيقي بتحط الكلاس في <code class="inl">test_wallet.py</code> وتشغّل <code class="inl">python -m unittest -v</code>.</p>
      </details>
    </div>

    <h4>اختبار سريع</h4>
    <div class="quiz">
      <div class="q" data-a="3">
        <p class="qt">1. <code class="inl">setUp</code> بتتنادى…</p>
        <label><input type="radio"> مرّة واحدة للكلاس</label>
        <label><input type="radio"> بعد كل اختبار</label>
        <label><input type="radio"> يدويًا</label>
        <label><input type="radio"> قبل كل اختبار</label>
      </div>
      <div class="q" data-a="1">
        <p class="qt">2. المكافئ لـ <code class="inl">assert x in items</code>…</p>
        <label><input type="radio"> assertEqual</label>
        <label><input type="radio"> assertIn</label>
        <label><input type="radio"> assertTrue(items)</label>
        <label><input type="radio"> assertIs</label>
      </div>
      <div class="q" data-a="0">
        <p class="qt">3. pytest تقدر تشغّل اختبارات unittest؟</p>
        <label><input type="radio"> أيوه، من غير أي تعديل</label>
        <label><input type="radio"> لأ</label>
        <label><input type="radio"> بعد تحويلها يدويًا</label>
        <label><input type="radio"> بس على لينكس</label>
      </div>
    </div>

@@append u16-l6
    <h4>تمرين سريع</h4>
    <div class="ex">
      <div class="bt"><span class="lvl">⭐⭐</span>توثيق بيختبر نفسه</div>
      <p>اكتب دالة <code class="inl">initials</code> بأمثلة doctest (منها حالة حدّية)، وشغّل الأمثلة برمجيًا واطبع النتيجة.</p>
      <details class="sol"><summary>شوف الحل</summary>
      @code run
import doctest ¦¦ المكتبة.
 ¦¦
def initials(name): ¦¦ الدالة.
    """ترجّع الحروف الأولى بحروف كبيرة. ¦¦ التوثيق.
 ¦¦
    >>> initials("ada lovelace") ¦¦ مثال: السطر بعد `>>>` بيتنفّذ…
    'AL' ¦¦ …والسطر اللي بعده هو الناتج المتوقّع بالظبط (بصيغة repr).
    >>> initials("  guido   van rossum ") ¦¦ مسافات زيادة.
    'GVR' ¦¦ المتوقّع.
    >>> initials("") ¦¦ حالة حدّية: نص فاضي.
    '' ¦¦ المتوقّع.
    """ ¦¦ نهاية التوثيق.
    return "".join(part[0].upper() for part in name.split()) ¦¦ `split()` من غير وسيط بتتجاهل المسافات الزيادة.
 ¦¦
runner = doctest.DocTestRunner() ¦¦ المشغّل (بيطبع الفاشل بس).
for test in doctest.DocTestFinder().find(initials, "initials", module=False, globs={"initials": initials}): ¦¦ استخراج الأمثلة من التوثيق.
    runner.run(test) ¦¦ تشغيلها.
print(runner.summarize(verbose=False)) ¦¦ (عدد الفاشل، عدد الأمثلة).
      @end
      @out
TestResults(failed=0, attempted=3)
      @end
      <p>في ملف حقيقي أسهل: <code class="inl">python -m doctest my_module.py -v</code>.</p>
      </details>
    </div>

    <h4>اختبار سريع</h4>
