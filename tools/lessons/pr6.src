        <label><input type="radio"> رسايل الأخطاء</label>
      </div>
      <div class="q" data-a="3">
        <p class="qt">2. الـ bytecode بيشغّله…</p>
        <label><input type="radio"> المعالج مباشرةً</label>
        <label><input type="radio"> نظام التشغيل</label>
        <label><input type="radio"> المتصفح</label>
        <label><input type="radio"> الآلة الافتراضية لبايثون (PVM)</label>
      </div>
