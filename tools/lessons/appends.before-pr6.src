    <h4>4. قراءة CSV وتحليله بـ pandas</h4>
    @code run
import pandas as pd ¦¦ المكتبة.
from io import StringIO ¦¦ بتخلّي النص يتقري كأنه ملف (في الحقيقة: `pd.read_csv("sales.csv")`).
 ¦¦
csv_text = """date,branch,product,qty,price ¦¦ ملف مبيعات: صف العناوين…
2025-03-01,Maadi,coffee,30,45 ¦¦ …والبيانات.
2025-03-01,Zamalek,tea,12,20 ¦¦ صف.
2025-03-02,Maadi,juice,18,35 ¦¦ صف.
2025-03-02,Zamalek,coffee,25,45 ¦¦ صف.
2025-03-03,Maadi,tea,20,20 ¦¦ صف.
""" ¦¦ قفل.
df = pd.read_csv(StringIO(csv_text), parse_dates=["date"]) ¦¦ **سطر واحد** بيقرا الملف كله لجدول — و `parse_dates` بتحوّل العمود لتواريخ حقيقية.
print(df.shape) ¦¦ (عدد الصفوف، عدد الأعمدة).
print(df["date"].dtype) ¦¦ نوع العمود بقى تاريخ.
df["revenue"] = df["qty"] * df["price"] ¦¦ **عمود جديد محسوب** لكل الصفوف مرّة واحدة.
print(df[df["revenue"] > 500][["branch", "product", "revenue"]]) ¦¦ **فلترة** بشرط ← واختيار أعمدة معيّنة.
print(df["revenue"].describe()[["mean", "max"]]) ¦¦ `describe` بتحسب إحصائيات جاهزة، وبنختار منها اتنين.
print(df.groupby(df["date"].dt.day)["revenue"].sum().to_dict()) ¦¦ الإيراد لكل يوم: `.dt.day` بتجيب رقم اليوم من التاريخ، و `to_dict` بترجّع قاموس بايثون عادي.
    @end
    @out
(5, 5)
