    <h4>11. البرمجة الكائنية</h4>
    @code norun
class Account: ¦¦ تعريف كلاس.
    rate = 0.05 ¦¦ خاصية كلاس (مشتركة).
    def __init__(self, owner, balance=0): ¦¦ المهيّئ.
        self.owner = owner ¦¦ خاصية كائن.
        self._balance = balance ¦¦ `_` = داخلي.
    @property ¦¦ خاصية للقراءة.
    def balance(self): ¦¦ الاسم العام.
        return self._balance ¦¦ القيمة.
    def __repr__(self): ¦¦ شكل العرض.
        return f"Account({self.owner!r})" ¦¦ `!r` = repr.
class Savings(Account): ¦¦ وراثة.
    def __init__(self, owner): ¦¦ مهيّئ الابن.
        super().__init__(owner) ¦¦ مهيّئ الأب.
    @end

    <h4>12. dataclass و Enum</h4>
    @code norun
from dataclasses import dataclass, field ¦¦ استيراد.
from enum import Enum ¦¦ استيراد.
class Status(Enum): ¦¦ قيم ثابتة.
    TODO = "todo" ¦¦ عضو.
@dataclass(order=True) ¦¦ كلاس بيانات قابل للترتيب.
class Task: ¦¦ الاسم.
    title: str ¦¦ حقل.
    tags: list[str] = field(default_factory=list) ¦¦ قائمة افتراضية آمنة.
    status: Status = Status.TODO ¦¦ حقل Enum.
    @end

    <h4>13. الـ comprehension والمولّدات</h4>
    @code norun
[x * 2 for x in nums if x > 0] ¦¦ قائمة بتحويل وفلتر.
{k: v for k, v in d.items() if v} ¦¦ قاموس.
{x % 3 for x in nums} ¦¦ مجموعة.
sum(x * x for x in nums) ¦¦ تعبير مولّد (من غير قائمة وسيطة).
any(n < 0 for n in nums) ¦¦ فيه واحد على الأقل؟
def gen(): ¦¦ دالة مولّد…
    yield 1 ¦¦ …بسبب yield.
next(iter(items), None) ¦¦ أول عنصر أو None.
    @end

