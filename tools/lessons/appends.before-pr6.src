@@append u14-l2
    <h4>6. أكواد الحالة (Status Codes)</h4>
    <div class="tbl-wrap">
      <table>
        <tr><th>الكود</th><th>المعنى</th><th>تعمل إيه؟</th></tr>
        <tr><td><strong>200</strong> OK</td><td>تمام</td><td>اقرا البيانات</td></tr>
        <tr><td><strong>201</strong> Created</td><td>اتعمل عنصر جديد (بعد POST)</td><td>اقرا العنصر الجديد</td></tr>
        <tr><td><strong>400</strong> Bad Request</td><td>الطلب نفسه غلط</td><td>راجع المعاملات والبيانات اللي بعتّها</td></tr>
        <tr><td><strong>401</strong> / <strong>403</strong></td><td>مش مسجّل / مش مسموح لك</td><td>راجع مفتاح الـ API أو الصلاحيات</td></tr>
        <tr><td><strong>404</strong> Not Found</td><td>الرابط أو العنصر مش موجود</td><td>راجع الرابط</td></tr>
        <tr><td><strong>429</strong> Too Many Requests</td><td>بعتّ طلبات كتير في وقت قصير</td><td>استنّى وجرّب تاني (فقرة 10)</td></tr>
        <tr><td><strong>500</strong> / <strong>503</strong></td><td>مشكلة عند الخادم</td><td>جرّب تاني بعدين — مش ذنبك</td></tr>
      </table>
    </div>
    <p>القاعدة: <strong>2xx نجاح، 4xx غلطتك، 5xx غلطة الخادم</strong>. و <code class="inl">response.ok</code> بتكون True لأي كود أقل من 400.</p>

    <h4>7. طلب GET بمعاملات وفحص الرد</h4>
    @code run params_demo.py
import requests ¦¦ المكتبة.
 ¦¦
response = requests.get( ¦¦ طلب GET…
    "https://httpbin.org/get", ¦¦ …لخدمة تجارب بترجّع اللي بعتّه (httpbin).
    params={"q": "بايثون", "page": 2}, ¦¦ `params` = معاملات الرابط. requests بتركّبها وبترمّز العربي لوحدها — ما تلصقهاش في الرابط بإيدك.
    timeout=10, ¦¦ مهلة.
) ¦¦ قفل.
print(response.status_code, response.ok) ¦¦ الكود، و `ok` = True لأي كود أقل من 400.
print(response.url) ¦¦ الرابط النهائي — العربي اتحوّل لصيغة URL.
print(response.headers["Content-Type"]) ¦¦ **الـ headers** = معلومات عن الرد. نوع المحتوى بيقولك تقراه إزاي.
print(response.json()["args"]) ¦¦ الخدمة رجّعت المعاملات اللي وصلتها — كلها نصوص.
    @end
    @out
200 True
https://httpbin.org/get?q=%D8%A8%D8%A7%D9%8A%D8%AB%D9%88%D9%86&page=2
application/json
{'page': '2', 'q': 'بايثون'}
    @end

    <h4>8. POST: إرسال بيانات ومفتاح الـ API</h4>
    @code run post_demo.py
import os ¦¦ لمتغيّرات البيئة.
import requests ¦¦ المكتبة.
 ¦¦
token = os.environ.get("API_TOKEN", "demo-token") ¦¦ **المفتاح من البيئة** مش مكتوب في الكود (درس الأمان في الوحدة 18). "demo-token" بس للتجربة.
response = requests.post( ¦¦ POST = «ابعت بيانات» (إنشاء أو تنفيذ حاجة).
    "https://httpbin.org/post", ¦¦ الرابط.
    json={"name": "sara", "score": 91}, ¦¦ `json=` بتحوّل القاموس لـ JSON وبتظبط نوع المحتوى لوحدها.
    headers={"Authorization": f"Bearer {token}"}, ¦¦ **headers الطلب**: أغلب الـ APIs بتستقبل المفتاح بالشكل ده.
    timeout=10, ¦¦ مهلة.
) ¦¦ قفل.
response.raise_for_status() ¦¦ أي كود خطأ ← استثناء.
echo = response.json() ¦¦ الخدمة بترجّع صورة من طلبنا.
print(echo["json"]) ¦¦ البيانات وصلت زي ما هي.
print(echo["headers"]["Authorization"]) ¦¦ والمفتاح وصل في الـ header.
    @end
    @out
{'name': 'sara', 'score': 91}
Bearer demo-token
    @end

    <h4>9. التعامل مع كل نوع خطأ لوحده</h4>
    @code run fetch_safe.py
import requests ¦¦ المكتبة.
 ¦¦
def fetch(url): ¦¦ دالة جلب «ما بتقعش».
    try: ¦¦ الجزء الخطر.
        response = requests.get(url, timeout=3) ¦¦ مهلة قصيرة للتجربة.
        response.raise_for_status() ¦¦ أكواد الخطأ ← HTTPError.
        return response.json() ¦¦ التحليل — ممكن يفشل لو الرد مش JSON.
    except requests.Timeout: ¦¦ الخادم اتأخّر.
        print("⏱ الخادم اتأخّر — جرّب تاني بعدين") ¦¦ رسالة مفهومة.
    except requests.ConnectionError: ¦¦ مفيش اتصال أصلًا (نت مقطوع أو عنوان غلط).
        print("🌐 مفيش اتصال بالخادم") ¦¦ رسالة.
    except requests.HTTPError as e: ¦¦ الخادم ردّ بكود خطأ.
        print(f"❌ الخادم رد بخطأ {e.response.status_code}") ¦¦ الكود نفسه جوّه الاستثناء.
    except ValueError: ¦¦ خطأ JSON بتاع requests بيورث من ValueError.
        print("📄 الرد مش JSON") ¦¦ رسالة.
    return None ¦¦ في كل حالات الفشل.
 ¦¦
fetch("https://httpbin.org/status/404") ¦¦ خطأ 404.
fetch("https://httpbin.org/delay/5") ¦¦ خادم بيتأخّر 5 ثواني والمهلة 3.
fetch("https://no-such-host.invalid") ¦¦ عنوان مش موجود.
fetch("https://httpbin.org/html") ¦¦ رد HTML مش JSON.
print(fetch("https://httpbin.org/json")["slideshow"]["title"]) ¦¦ الحالة السليمة.
    @end
    @out
❌ الخادم رد بخطأ 404
⏱ الخادم اتأخّر — جرّب تاني بعدين
🌐 مفيش اتصال بالخادم
📄 الرد مش JSON
Sample Slide Show
    @end

    <h4>10. إعادة المحاولة واحترام حدود الخدمة</h4>
    @code run retry_demo.py
import time ¦¦ للانتظار.
import requests ¦¦ المكتبة.
 ¦¦
def get_with_retry(url, attempts=3, wait=1): ¦¦ جلب بإعادة محاولة.
    for attempt in range(1, attempts + 1): ¦¦ محاولة ورا محاولة.
        try: ¦¦ الجزء الخطر.
            response = requests.get(url, timeout=5) ¦¦ الطلب.
            response.raise_for_status() ¦¦ 429 و 5xx بتترمي هنا.
            return response ¦¦ نجح ← نرجّع فورًا.
        except (requests.Timeout, requests.ConnectionError, requests.HTTPError) as e: ¦¦ الأخطاء اللي ممكن تتحل لوحدها بعد شوية.
            print(f"محاولة {attempt} فشلت: {type(e).__name__}") ¦¦ تسجيل.
            if attempt == attempts: ¦¦ آخر محاولة؟
                raise ¦¦ نرمي نفس الخطأ للي نادى (الوحدة 15).
            time.sleep(wait * attempt) ¦¦ **انتظار متزايد** (1 ثم 2 ثم 3…) عشان ما نضغطش على الخادم.
 ¦¦
try: ¦¦ تجربة على خادم «واقع» دايمًا.
    get_with_retry("https://httpbin.org/status/503", attempts=2, wait=0.5) ¦¦ محاولتين بس للتجربة.
except requests.HTTPError: ¦¦ بعد ما كل المحاولات فشلت.
    print("استسلمنا بعد كل المحاولات") ¦¦ القرار النهائي.
    @end
    @out
محاولة 1 فشلت: HTTPError
محاولة 2 فشلت: HTTPError
استسلمنا بعد كل المحاولات
    @end
    <div class="box tip">
      <div class="bt">💡 قبل ما تستخدم أي API</div>
      <ul>
        <li><strong>اقرا التوثيق بتاعه</strong>: الروابط، المعاملات، شكل الرد، وحدود الطلبات (rate limit).</li>
        <li><strong>التقسيم لصفحات (pagination)</strong>: النتايج الكتير بتيجي على دفعات بمعامل زي <code class="inl">page</code> — لفّ لحد ما الرد يرجع فاضي.</li>
        <li><strong>المفاتيح في متغيّرات البيئة</strong> أو <code class="inl">.env</code> — عمرها ما تترفع على GitHub.</li>
        <li><strong>كل الأمثلة هنا متشغّلة على httpbin.org</strong> — خدمة مجانية للتجربة بترجّع اللي بتبعته.</li>
      </ul>
    </div>

@@append u16-l5
    <h4>4. subTest والتخطّي: حالات كتير في اختبار واحد</h4>
    @code run
import io ¦¦ عشان نجمع تقرير الاختبارات في الذاكرة بدل الشاشة.
import unittest ¦¦ المكتبة.
 ¦¦
def is_even(n): ¦¦ الدالة المختبرة.
    return n % 2 == 0 ¦¦ صحيحة.
 ¦¦
class TestEven(unittest.TestCase): ¦¦ كلاس الاختبارات.
    def test_many(self): ¦¦ اختبار واحد بحالات كتير.
        cases = [(2, True), (7, False), (0, True), (-4, True), (9, True)] ¦¦ آخر حالة **غلط عن قصد** (9 مش زوجي).
        for number, expected in cases: ¦¦ على كل حالة.
            with self.subTest(number=number): ¦¦ `subTest` بتخلّي كل حالة تتقيّم لوحدها — فشل واحدة ما يوقفش الباقي، والتقرير بيقول أنهي رقم وقع (زي parametrize في pytest).
                self.assertEqual(is_even(number), expected) ¦¦ التحقّق.
 ¦¦
    @unittest.skip("مثال على التخطّي") ¦¦ تخطّي اختبار مؤقّتًا مع ذكر السبب.
    def test_later(self): ¦¦ اختبار مش جاهز.
        pass ¦¦ فاضي.
 ¦¦
suite = unittest.defaultTestLoader.loadTestsFromTestCase(TestEven) ¦¦ تجميع اختبارات الكلاس.
result = unittest.TextTestRunner(stream=io.StringIO()).run(suite) ¦¦ تشغيل وحفظ التقرير في الذاكرة.
print("اتشغّل:", result.testsRun) ¦¦ عدد الاختبارات.
print("فشل:", len(result.failures)) ¦¦ الحالات الفاشلة.
print("اتخطّى:", len(result.skipped)) ¦¦ المتخطّاة.
print(result.failures[0][1].splitlines()[-1]) ¦¦ آخر سطر من تقرير الفشل.
    @end
    @out
اتشغّل: 2
فشل: 1
اتخطّى: 1
AssertionError: False != True
    @end

    <h4>5. المحاكاة (mock) مع unittest</h4>
    @code run
import io ¦¦ للتقرير.
import random ¦¦ المكتبة اللي هنستبدلها.
import unittest ¦¦ الاختبارات.
from unittest.mock import patch ¦¦ أداة الاستبدال (درس المحاكاة).
 ¦¦
def roll_dice(): ¦¦ دالة نتيجتها عشوائية — صعب نختبرها كما هي.
    return random.randint(1, 6) ¦¦ رقم عشوائي.
 ¦¦
class TestDice(unittest.TestCase): ¦¦ الاختبار.
    @patch("random.randint", return_value=6) ¦¦ أثناء الاختبار ده بس، `random.randint` بترجّع 6 دايمًا. النسخة المزيّفة بتتبعت كوسيط.
    def test_six(self, fake): ¦¦ `fake` = الكائن المزيّف.
        self.assertEqual(roll_dice(), 6) ¦¦ النتيجة بقت متوقّعة.
        fake.assert_called_once_with(1, 6) ¦¦ وبنتأكّد كمان إن الدالة اتنادت بالوسائط الصح.
 ¦¦
loader = unittest.defaultTestLoader ¦¦ المحمّل.
result = unittest.TextTestRunner(stream=io.StringIO()).run(loader.loadTestsFromTestCase(TestDice)) ¦¦ تشغيل.
print(result.wasSuccessful()) ¦¦ كله نجح؟
    @end
    @out
True
    @end

