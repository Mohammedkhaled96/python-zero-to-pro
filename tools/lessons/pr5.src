@@append u11-l8
    <h4>تمرين سريع</h4>
    <div class="ex">
      <div class="bt"><span class="lvl">⭐⭐⭐</span>الأربعة في مثال واحد</div>
      <p>decorator بيقيس الوقت، و <code class="inl">match</code> بيفسّر أوامر، و <code class="inl">:=</code> في شرط، ومدير سياق بتاعك.</p>
      <details class="sol"><summary>شوف الحل</summary>
      @code run
import time ¦¦ للقياس.
from contextlib import contextmanager ¦¦ أسهل طريقة لمدير سياق.
from functools import wraps ¦¦ بتحافظ على اسم الدالة الأصلية.
 ¦¦
def timed(func): ¦¦ **decorator**: بياخد دالة ويرجّع دالة.
    @wraps(func) ¦¦ من غيرها اسم الدالة يبقى wrapper.
    def wrapper(*args, **kwargs): ¦¦ بيقبل أي وسائط.
        start = time.perf_counter() ¦¦ قبل.
        result = func(*args, **kwargs) ¦¦ الدالة الأصلية.
        print(f"[{func.__name__}] خلصت") ¦¦ مش بنطبع الوقت نفسه عشان الناتج يبقى ثابت.
        return result ¦¦ نرجّع نتيجتها زي ما هي.
    return wrapper ¦¦ الدالة المغلّفة.
 ¦¦
@timed ¦¦ = `slow = timed(slow)`.
def total(n): ¦¦ الدالة.
    return sum(range(n)) ¦¦ شغل بسيط.
 ¦¦
print(total(1000)) ¦¦ الـ decorator طبع سطره، وبعدين النتيجة.
print(total.__name__) ¦¦ بفضل `wraps` الاسم لسه صح.
 ¦¦
def run(command): ¦¦ مطابقة الأنماط.
    match command.split(): ¦¦ بنطابق على **قائمة** الكلمات.
        case ["add", x, y]: ¦¦ نمط بثلاث كلمات — x و y بيتربطوا.
            return int(x) + int(y) ¦¦ النتيجة.
        case ["quit"] | ["exit"]: ¦¦ نمطين في حالة واحدة.
            return "وداعًا" ¦¦ الخروج.
        case _: ¦¦ الباقي (زي else).
            return "أمر مش معروف" ¦¦ الافتراضي.
print(run("add 2 3"), run("exit"), run("dance")) ¦¦ تلات حالات.
 ¦¦
names = ["سارة", "علي"] ¦¦ بيانات.
if (count := len(names)) > 1: ¦¦ **الوالروس**: نحسب ونخزّن ونقارن في سطر واحد.
    print(f"عندنا {count} أسماء") ¦¦ بنستخدم القيمة المحفوظة.
 ¦¦
@contextmanager ¦¦ مدير سياق من دالة واحدة.
def section(title): ¦¦ الدالة.
    print(f"── {title} ──") ¦¦ قبل الـ with.
    try: ¦¦ نحمي التسليم.
        yield ¦¦ هنا بيتنفّذ جسم الـ with.
    finally: ¦¦ دايمًا.
        print("── تم ──") ¦¦ بعد الـ with، حتى لو حصل خطأ.
 ¦¦
with section("التقرير"): ¦¦ الاستخدام.
    print("سطر جوّه القسم") ¦¦ الجسم.
      @end
      @out rtl
[total] خلصت
499500
total
5 وداعًا أمر مش معروف
عندنا 2 أسماء
── التقرير ──
سطر جوّه القسم
── تم ──
      @end
      </details>
    </div>

@@append u12-l7
    <h4>تمرين سريع</h4>
    <div class="ex">
      <div class="bt"><span class="lvl">⭐⭐</span>جدول كتب</div>
      <p>اعمل جدول كتب في الذاكرة، ضيف صفوف بـ <code class="inl">?</code>، واستعلم: الأغلى، والمتوسّط، وتجميع حسب التصنيف.</p>
      <details class="sol"><summary>شوف الحل</summary>
      @code run
import sqlite3 ¦¦ مدمجة في بايثون.
conn = sqlite3.connect(":memory:") ¦¦ قاعدة في الذاكرة — مثالية للتجربة.
cur = conn.cursor() ¦¦ المؤشّر بينفّذ الأوامر.
cur.execute("CREATE TABLE books (id INTEGER PRIMARY KEY, title TEXT NOT NULL, genre TEXT, price REAL)") ¦¦ إنشاء الجدول وأنواع الأعمدة.
books = [("بايثون من الصفر", "تقنية", 180.0), ("الخوارزميات", "تقنية", 250.0), ("رحلة في الفضاء", "علوم", 120.0)] ¦¦ بيانات.
cur.executemany("INSERT INTO books (title, genre, price) VALUES (?, ?, ?)", books) ¦¦ `executemany` + `?` = آمن وسريع.
conn.commit() ¦¦ تثبيت.
print(cur.execute("SELECT title, price FROM books ORDER BY price DESC LIMIT 1").fetchone()) ¦¦ الأغلى: ترتيب تنازلي وأول صف.
print(cur.execute("SELECT COUNT(*), ROUND(AVG(price), 1) FROM books").fetchone()) ¦¦ العدد والمتوسّط من قاعدة البيانات نفسها.
for genre, count in cur.execute("SELECT genre, COUNT(*) FROM books GROUP BY genre ORDER BY genre"): ¦¦ تجميع.
    print(genre, count) ¦¦ كل تصنيف وعدده.
conn.close() ¦¦ إغلاق الاتصال.
      @end
      @out rtl
('الخوارزميات', 250.0)
(3, 183.3)
تقنية 2
علوم 1
      @end
      </details>
    </div>

