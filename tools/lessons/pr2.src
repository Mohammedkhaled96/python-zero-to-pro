    <h4>تمرين سريع</h4>
    <div class="ex">
      <div class="bt"><span class="lvl">⭐⭐</span>دخول بمستويين</div>
      <p>اكتب فحص دخول بشرطين متداخلين (مستخدم ثم كلمة سر)، وبعدين اكتبه بشرط واحد لو الرسايل مش مهم تفرق.</p>
      <details class="sol"><summary>شوف الحل</summary>
      @code run
username = "admin" ¦¦ المستخدم.
password = "1234" ¦¦ كلمة السر (للتجربة بس!).
if username == "admin": ¦¦ المستوى الأول.
    if password == "1234": ¦¦ المستوى التاني — بيتفحص بس لو الأول صح.
        print("أهلًا يا مدير") ¦¦ الاتنين صح.
    else: ¦¦ المستخدم صح وكلمة السر غلط.
        print("كلمة السر غلط") ¦¦ رسالة مخصّصة.
else: ¦¦ المستخدم نفسه غلط.
    print("مستخدم مش معروف") ¦¦ رسالة.
if username == "admin" and password == "1234": ¦¦ نفس الفحص مسطّح — أوضح لما مش محتاج رسالة لكل حالة.
    print("نفس النتيجة بشرط واحد") ¦¦ الفرع.
      @end
      @out rtl
أهلًا يا مدير
نفس النتيجة بشرط واحد
      @end
      </details>
    </div>

