@@append u5-l5
    <h4>تمرين سريع</h4>
    <div class="ex">
      <div class="bt"><span class="lvl">⭐⭐⭐</span>سطحي ولّا عميق؟</div>
      <p>توقّع السطرين قبل التشغيل.</p>
      <details class="sol"><summary>شوف الحل</summary>
      @code run
import copy ¦¦ مكتبة النسخ.
 ¦¦
menu = [["قهوة", 20], ["شاي", 10]] ¦¦ قائمة قوائم.
shallow = menu.copy() ¦¦ نسخة سطحية: قائمة خارجية جديدة بنفس القوائم الداخلية.
deep = copy.deepcopy(menu) ¦¦ نسخة عميقة: كل حاجة جديدة.
menu[0][1] = 25 ¦¦ تعديل **جوّه** قائمة داخلية.
print(shallow[0][1], deep[0][1]) ¦¦ السطحية شايفة التعديل (نفس القائمة الداخلية)، والعميقة لأ.
shallow.append(["عصير", 15]) ¦¦ إضافة للقائمة الخارجية للنسخة.
print(len(menu), len(shallow)) ¦¦ القائمة الخارجية مستقلّة فعلًا.
      @end
      @out
25 20
2 3
      @end
      </details>
    </div>

    <h4>اختبار سريع</h4>
    <div class="quiz">
      <div class="q" data-a="3">
