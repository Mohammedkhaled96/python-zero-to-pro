@@append u5-l6
    <h4>تمرين سريع</h4>
    <div class="ex">
      <div class="bt"><span class="lvl">⭐⭐</span>جولة في المرجع</div>
      <p>استخدم <code class="inl">count</code> و <code class="inl">index</code> و <code class="inl">reverse</code> و <code class="inl">any</code> و <code class="inl">all</code> — وخلّي بالك من آخر سطر.</p>
      <details class="sol"><summary>شوف الحل</summary>
      @code run
nums = [5, 3, 8, 3, 1] ¦¦ قائمة.
print(nums.count(3), nums.index(8)) ¦¦ مرّات ظهور 3، ومكان أول 8.
nums.reverse() ¦¦ عكس في المكان.
print(nums) ¦¦ بعد العكس.
print(any(nums), all(nums)) ¦¦ فيه رقم مش صفر؟ وكلهم مش صفر؟
nums.clear() ¦¦ تفريغ.
print(nums, all(nums)) ¦¦ ⚠️ `all` على قائمة **فاضية** بترجّع True («مفيش عنصر كاذب») — خلّي بالك منها في الشروط.
      @end
      @out
2 2
[1, 3, 8, 3, 5]
True True
[] True
      @end
      </details>
    </div>

    <h4>اختبار سريع</h4>
    <div class="quiz">
      <div class="q" data-a="2">
        <p class="qt">1. <code class="inl">["a", "b", "a"].index("a")</code>؟</p>
        <label><input type="radio"> [0, 2]</label>
        <label><input type="radio"> 2</label>
