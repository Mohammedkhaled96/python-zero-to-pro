@@append u8-l1
    <h4>تمرين سريع</h4>
    <div class="ex">
      <div class="bt"><span class="lvl">⭐</span>ضاعف لحد الألف</div>
      <p>ابدأ من 1 وضاعف لحد ما القيمة تعدّي 1000. كام خطوة؟</p>
      <details class="sol"><summary>شوف الحل</summary>
      @code run
value = 1 ¦¦ القيمة الابتدائية (المكوّن 1).
steps = 0 ¦¦ عدّاد.
while value <= 1000: ¦¦ الشرط (المكوّن 2).
    value *= 2 ¦¦ التحديث (المكوّن 3) — من غيره الحلقة ما بتخلصش.
    steps += 1 ¦¦ عدّ.
print(value, steps) ¦¦ 2 أس 10.
      @end
      @out
1024 10
      @end
      </details>
    </div>

