@@append u8-l2
    <h4>تمرين سريع</h4>
    <div class="ex">
      <div class="bt"><span class="lvl">⭐⭐</span>اسأل لحد ما يجاوب صح</div>
      <p>حاكي مستخدم كتب 3 إجابات: اقبل أول رقم صحيح موجب، وارفض الباقي برسالة. (في برنامج حقيقي بدّل القائمة بـ <code class="inl">input</code>.)</p>
      <details class="sol"><summary>شوف الحل</summary>
      @code run
answers = ["abc", "-5", "17"] ¦¦ مدخلات «مزيّفة» بدل input — عشان نقدر نجرّب.
i = 0 ¦¦ فهرس الإجابة الجاية.
while True: ¦¦ كرّر لحد ما break.
    text = answers[i] ¦¦ في الحقيقة: `text = input("عمرك: ")`.
    i += 1 ¦¦ الإجابة اللي بعدها.
    if text.isdigit(): ¦¦ أرقام بس؟ (بترفض السالب والحروف).
        age = int(text) ¦¦ التحويل آمن دلوقتي.
        break ¦¦ نخرج.
    print(f"«{text}» مش رقم صحيح موجب — حاول تاني") ¦¦ رسالة واضحة.
print("العمر:", age) ¦¦ بعد الحلقة، القيمة سليمة أكيد.
      @end
      @out rtl
«abc» مش رقم صحيح موجب — حاول تاني
«-5» مش رقم صحيح موجب — حاول تاني
العمر: 17
      @end
      </details>
    </div>

    <h4>اختبار سريع</h4>
