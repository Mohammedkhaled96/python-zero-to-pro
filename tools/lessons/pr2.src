        <p class="qt">3. أنهي قيمة Truthy؟</p>
        <label><input type="radio"> 0</label>
        <label><input type="radio"> " " (مسافة)</label>
        <label><input type="radio"> ""</label>
        <label><input type="radio"> None</label>
      </div>
    </div>

