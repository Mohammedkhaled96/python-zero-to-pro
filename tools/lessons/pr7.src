@@append u19-l3
    <h4>تمرين سريع</h4>
    <div class="ex">
      <div class="bt"><span class="lvl">⭐⭐</span>أقرب جار بإيدك</div>
      <p>نفّذ 1-NN: صنّف فاكهة جديدة (وزن، خشونة) حسب أقرب مثال، وبعدين قسّم البيانات تدريب/اختبار وقيس الدقّة.</p>
      <details class="sol"><summary>شوف الحل</summary>
      @code run
train = [ ¦¦ (وزن بالجرام، خشونة من 10، النوع).
    (150, 8, "برتقان"), (170, 9, "برتقان"), (140, 7, "برتقان"), ¦¦ أمثلة برتقان.
    (120, 2, "تفاح"), (130, 3, "تفاح"), (110, 1, "تفاح"), ¦¦ أمثلة تفاح.
] ¦¦ بيانات التدريب.
def distance(a, b): ¦¦ المسافة بين نقطتين.
    return ((a[0] - b[0]) ** 2 + (a[1] - b[1]) ** 2) ** 0.5 ¦¦ فيثاغورس — بس الوزن بيسيطر لأن مداه أكبر (عشان كده بنعمل تقييس في الحقيقة).
def classify(point): ¦¦ 1-NN.
    nearest = min(train, key=lambda row: distance(row, point)) ¦¦ أقرب مثال.
    return nearest[2] ¦¦ نوعه هو تنبؤنا.
print(classify((160, 8))) ¦¦ تقيل وخشن ← برتقان.
print(classify((115, 2))) ¦¦ خفيف وناعم ← تفاح.
test = [(155, 9, "برتقان"), (125, 2, "تفاح"), (135, 6, "برتقان")] ¦¦ بيانات **اختبار** لسه النموذج ما شافهاش.
correct = sum(1 for point in test if classify(point) == point[2]) ¦¦ نعدّ الصح.
print(f"الدقّة: {correct}/{len(test)}") ¦¦ 3 من 3 — البيانات هنا مفصولة بوضوح. جرّب تضيف عيّنة على الحدّ (130, 5) وشوف النموذج هيغلط.
      @end
      @out rtl
برتقان
تفاح
الدقّة: 3/3
      @end
      </details>
    </div>

