        <label><input type="radio"> ذكاء اصطناعي ← تعلّم آلة ← تعلّم عميق</label>
        <label><input type="radio"> تعلّم آلة ← ذكاء اصطناعي ← تعلّم عميق</label>
        <label><input type="radio"> كلهم نفس الحاجة</label>
      </div>
      <div class="q" data-a="0">
