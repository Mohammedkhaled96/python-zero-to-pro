@@append u9-l4
    <h4>تمرين سريع</h4>
    <div class="ex">
      <div class="bt"><span class="lvl">⭐⭐</span>آلة قسمة كاملة</div>
      <p>لكل زوج: اقسم، ومَيّز بين القسمة على صفر والنص الغلط، واطبع النتيجة في else، وسطر ختام في finally.</p>
      <details class="sol"><summary>شوف الحل</summary>
      @code run
pairs = [("10", "2"), ("7", "0"), ("x", "3")] ¦¦ أزواج نصوص.
for a, b in pairs: ¦¦ تفكيك كل زوج.
    try: ¦¦ الجزء الخطر بس.
        result = int(a) / int(b) ¦¦ خطأين محتملين.
    except ZeroDivisionError: ¦¦ الأول.
        print("ما ينفعش تقسم على صفر") ¦¦ رسالته.
    except ValueError: ¦¦ التاني.
        print("لازم أرقام") ¦¦ رسالته.
    else: ¦¦ بتتنفّذ **بس** لو مفيش خطأ.
        print("الناتج:", result) ¦¦ النتيجة.
    finally: ¦¦ بتتنفّذ **دايمًا**.
        print("--") ¦¦ فاصل.
      @end
      @out rtl
الناتج: 5.0
--
ما ينفعش تقسم على صفر
--
لازم أرقام
--
      @end
      </details>
    </div>

    <h4>اختبار سريع</h4>
    <div class="quiz">
      <div class="q" data-a="1">
        <p class="qt">1. <code class="inl">else</code> بعد try بتتنفّذ إمتى؟</p>
        <label><input type="radio"> لما يحصل خطأ</label>
        <label><input type="radio"> لما ما يحصلش خطأ</label>
        <label><input type="radio"> دايمًا</label>
        <label><input type="radio"> أبدًا</label>
      </div>
      <div class="q" data-a="0">
        <p class="qt">2. أنسب مكان لقفل ملف أو اتصال…</p>
        <label><input type="radio"> finally</label>
        <label><input type="radio"> else</label>
        <label><input type="radio"> except</label>
        <label><input type="radio"> قبل try</label>
      </div>
      <div class="q" data-a="3">
        <p class="qt">3. تمسك نوعين بنفس المعالجة…</p>
        <label><input type="radio"> except ValueError or TypeError:</label>
        <label><input type="radio"> except ValueError and TypeError:</label>
        <label><input type="radio"> except [ValueError, TypeError]:</label>
        <label><input type="radio"> except (ValueError, TypeError):</label>
      </div>
    </div>

