@@append u12-l2
    <h4>تمرين سريع</h4>
    <div class="ex">
      <div class="bt"><span class="lvl">⭐⭐</span>عدّاد سطور وكلمات</div>
      <p>اكتب ملف صغير، وبعدين اقراه سطر سطر: عدّ السطور غير الفاضية والكلمات، واطبع أطول سطر.</p>
      <details class="sol"><summary>شوف الحل</summary>
      @code run
with open("poem.txt", "w", encoding="utf-8") as f: ¦¦ تجهيز ملف للتجربة.
    f.write("البرمجة متعة\n\nوبايثون لغة سهلة جدا\nاتعلم كل يوم\n") ¦¦ فيه سطر فاضي.
lines = 0 ¦¦ عدّاد السطور.
words = 0 ¦¦ عدّاد الكلمات.
longest = "" ¦¦ أطول سطر.
with open("poem.txt", encoding="utf-8") as f: ¦¦ القراءة (الوضع الافتراضي r).
    for line in f: ¦¦ الملف قابل للمرور سطر سطر — موفّر للذاكرة.
        line = line.strip() ¦¦ نشيل `\n` والمسافات.
        if not line: ¦¦ سطر فاضي؟
            continue ¦¦ نتخطّاه.
        lines += 1 ¦¦ عدّ.
        words += len(line.split()) ¦¦ كلمات السطر.
        if len(line) > len(longest): ¦¦ أطول؟
            longest = line ¦¦ نحفظه.
print(lines, words) ¦¦ النتيجة.
print(longest) ¦¦ أطول سطر.
      @end
      @out rtl
3 9
وبايثون لغة سهلة جدا
      @end
      </details>
    </div>

    <h4>اختبار سريع</h4>
    <div class="quiz">
      <div class="q" data-a="1">
        <p class="qt">1. <code class="inl">f.readlines()</code> بترجّع…</p>
        <label><input type="radio"> نص واحد</label>
        <label><input type="radio"> قائمة سطور، كل سطر بـ <code class="inl">\n</code> في آخره</label>
        <label><input type="radio"> أول سطر بس</label>
        <label><input type="radio"> عدد السطور</label>
      </div>
      <div class="q" data-a="2">
        <p class="qt">2. ملف 5 جيجا — أنسب طريقة للقراءة؟</p>
        <label><input type="radio"> f.read()</label>
        <label><input type="radio"> f.readlines()</label>
        <label><input type="radio"> for line in f</label>
        <label><input type="radio"> مستحيل</label>
      </div>
      <div class="q" data-a="0">
        <p class="qt">3. بعد <code class="inl">f.read()</code> مرّة، <code class="inl">f.read()</code> تاني بترجّع…</p>
        <label><input type="radio"> "" — المؤشّر وصل للآخر</label>
        <label><input type="radio"> نفس المحتوى</label>
        <label><input type="radio"> خطأ</label>
        <label><input type="radio"> None</label>
      </div>
    </div>

@@append u12-l3
    <h4>تمرين سريع</h4>
    <div class="ex">
      <div class="bt"><span class="lvl">⭐⭐</span>تقرير درجات لملف</div>
      <p>اكتب تقرير من قاموس درجات لملف (سطر لكل طالب)، وبعدين اقراه للتأكيد.</p>
      <details class="sol"><summary>شوف الحل</summary>
      @code run
grades = {"سارة": 92, "علي": 67, "منى": 78} ¦¦ البيانات.
with open("report.txt", "w", encoding="utf-8") as f: ¦¦ ملف جديد.
    f.write("تقرير الدرجات\n") ¦¦ `write` مش بتضيف سطر جديد لوحدها — لازم `\n`.
    for name, g in grades.items(): ¦¦ على كل طالب.
        status = "ناجح" if g >= 70 else "محتاج مراجعة" ¦¦ الحالة.
        print(f"{name}: {g} ({status})", file=f) ¦¦ `print(..., file=f)` بتكتب في الملف ومعاها `\n`.
    f.writelines(["---\n", "النهاية\n"]) ¦¦ `writelines` بتكتب قائمة نصوص (من غير ما تضيف `\n`).
with open("report.txt", encoding="utf-8") as f: ¦¦ القراءة للتأكيد.
    print(f.read(), end="") ¦¦ المحتوى.
      @end
      @out rtl
تقرير الدرجات
سارة: 92 (ناجح)
علي: 67 (محتاج مراجعة)
منى: 78 (ناجح)
---
النهاية
      @end
      </details>
    </div>

    <h4>اختبار سريع</h4>
    <div class="quiz">
      <div class="q" data-a="0">
        <p class="qt">1. <code class="inl">f.write(5)</code>؟</p>
        <label><input type="radio"> TypeError — write بتقبل نصوص بس</label>
        <label><input type="radio"> بتكتب 5</label>
