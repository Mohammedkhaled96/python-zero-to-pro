@@append u12-l1
    <h4>تمرين سريع</h4>
    <div class="ex">
      <div class="bt"><span class="lvl">⭐⭐</span>تلات أوضاع</div>
      <p>اكتب ملف بـ <code class="inl">"w"</code>، زوّد عليه بـ <code class="inl">"a"</code>، اقراه بـ <code class="inl">"r"</code>، وجرّب <code class="inl">"x"</code> على ملف موجود.</p>
      <details class="sol"><summary>شوف الحل</summary>
      @code run
with open("notes.txt", "w", encoding="utf-8") as f: ¦¦ `w` بتنشئ الملف أو **تمسح** محتواه.
    f.write("السطر الأول\n") ¦¦ كتابة.
with open("notes.txt", "a", encoding="utf-8") as f: ¦¦ `a` بتزوّد في الآخر.
    f.write("السطر التاني\n") ¦¦ إضافة.
with open("notes.txt", "r", encoding="utf-8") as f: ¦¦ `r` قراءة (الافتراضي).
    print(f.read(), end="") ¦¦ المحتوى كله؛ `end=""` لأن آخره سطر جديد بالفعل.
print(f.closed) ¦¦ `with` قفلت الملف أوتوماتيك.
try: ¦¦ `x` = إنشاء فقط.
    open("notes.txt", "x") ¦¦ الملف موجود ← خطأ (حماية من المسح بالغلط).
except FileExistsError: ¦¦ نمسكه.
    print("الملف موجود — x رفضت تمسحه") ¦¦ رسالة.
      @end
      @out rtl
السطر الأول
السطر التاني
True
الملف موجود — x رفضت تمسحه
      @end
      </details>
    </div>

