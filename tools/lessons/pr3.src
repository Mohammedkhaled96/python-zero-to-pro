    [1, 2][5] ¦¦ فهرس برّه القائمة.
except IndexError as e: ¦¦ نمسكه.
    print(type(e).__name__) ¦¦ `type(e).__name__` = اسم النوع كنص.
try: ¦¦ التاني.
    {"a": 1}["b"] ¦¦ مفتاح مش موجود.
except KeyError as e: ¦¦ نمسكه.
    print(type(e).__name__, e) ¦¦ الرسالة = المفتاح الناقص.
try: ¦¦ التالت.
    "5" + 5 ¦¦ نص + رقم.
except TypeError as e: ¦¦ نمسكه.
    print(type(e).__name__) ¦¦ اسم النوع.
try: ¦¦ الرابع.
    print(undefined_name) ¦¦ اسم مش معرّف.
except NameError as e: ¦¦ نمسكه.
    print(type(e).__name__) ¦¦ اسم النوع.
      @end
      @out
IndexError
KeyError 'b'
TypeError
NameError
      @end
      </details>
    </div>

