@@append u11-l4
    <h4>تمرين سريع</h4>
    <div class="ex">
      <div class="bt"><span class="lvl">⭐⭐⭐</span>تتبّع النطاق</div>
      <p>توقّع كل سطر — وبعدين شوف الطريقة الأنضف من <code class="inl">global</code>.</p>
      <details class="sol"><summary>شوف الحل</summary>
      @code run
count = 0 ¦¦ متغيّر عام.
 ¦¦
def local_only(): ¦¦ دالة.
    count = 99 ¦¦ ده متغيّر **محلّي جديد** بنفس الاسم — مش بيلمس العام.
    return count ¦¦ بيرجّع المحلّي.
 ¦¦
def with_global(): ¦¦ دالة بتعدّل العام.
    global count ¦¦ تصريح صريح.
    count += 1 ¦¦ تعديل العام.
 ¦¦
def cleaner(value): ¦¦ الأنضف: خُد القيمة كوسيط…
    return value + 1 ¦¦ …ورجّع الجديدة.
 ¦¦
print(local_only(), count) ¦¦ 99 من الدالة، والعام لسه 0.
with_global() ¦¦ بيعدّل العام.
print(count) ¦¦ 1.
count = cleaner(count) ¦¦ اللي بينادي هو اللي بيقرّر يحفظ — أوضح وأسهل في الاختبار.
print(count) ¦¦ 2.
      @end
      @out
99 0
1
2
      @end
      </details>
    </div>

    <h4>اختبار سريع</h4>
